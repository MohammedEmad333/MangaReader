<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Yomu" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Yomu.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@color/window_background_light</item>
        <item name="android:navigationBarColor">@color/window_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The manifest launch theme stays dark so a fresh install matches Yomu's
         default. MainActivity replaces it before super.onCreate() with the
         persisted light/dark window theme, so returning light-theme users do
         not get a dark window between the splash and the first Compose frame. -->
    <style name="Theme.Yomu.Splash" parent="Theme.Yomu">
        <item name="android:windowBackground">@drawable/splash_yomu</item>
    </style>
</resources>
