<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to download JSON and APKs -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to prompt the user to install an APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The uninstall counterpart. The system still shows its own confirmation;
         this only buys the right to ask for it. Without it the request is
         refused on API 26+ and, on some ROMs, refused silently - which is
         exactly how it presented: a tap, a flicker, and the package still
         installed. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Lets us enumerate installed extension packages on Android 11+.
         This is what ExtensionLoader relies on to find packages declaring
         the tachiyomi.extension feature. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Chapter and HLS downloads run in foreground services so they survive
         backgrounding. DATA_SYNC is the type Android 14 requires here. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ needs this granted before the progress notification shows.
         Downloads still run if it's refused; only the notification is lost. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A foreground service keeps the process alive but not the CPU: without
         this the device can suspend mid-transfer with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Storage location. Downloads default to the app's own filesDir and need
         none of these; they're what lets the user put downloads in a folder a
         file manager can see, which survives uninstalling.

         Three eras, because minSdk is 24:
         - API 30+ uses MANAGE_EXTERNAL_STORAGE, granted on a system settings
           page rather than a dialog. Google restricts it on Play; this app is
           sideloaded from GitHub Releases, so that restriction doesn't apply.
         - API 29 has scoped storage but honours requestLegacyExternalStorage
           below, so the old runtime permission still works there.
         - API 24-28 is the plain runtime permission.
         The maxSdkVersion caps stop the older two being requested on versions
         where they do nothing but sit in the app's permission list. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".App"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Yomu"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yomu">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Handle configuration changes rather than being recreated by them.

             Every piece of YomuApp's state lives in `remember`, not
             `rememberSaveable` — the active source, series, chapter list and
             loaded pages include objects that can't be put in a Bundle at all.
             So an Activity recreation isn't a blip, it's a full reset to the
             Library tab, and anything that provokes one throws away what the
             user was reading.

             The reader's rotation setting provoked one every time it opened:
             setting requestedOrientation *is* a configuration change, so the
             reader recreated the Activity, lost itself, and dropped back to the
             Library — repeatedly, with no way to reach the setting and turn it
             off. Declaring these makes the change something Compose absorbs by
             recomposing, which it does natively through LocalConfiguration.

             This also fixes the older, quieter version of the same bug: simply
             rotating the phone mid-chapter used to lose your place. -->
        <activity
            android:name=".VideoPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Yomu" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.Yomu.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- WorkManager's foreground dispatcher is used by long HLS downloads.
             Merge the dataSync type onto its library manifest declaration. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- The library refresh sweeps every saved series for its chapter list,
             which is minutes of network work on a large library. Same reasoning
             as the downloader: it has to survive the app being backgrounded, so
             it's a foreground service rather than a coroutine in YomuApp's
             scope, and dataSync is the type Android 14 requires for it.

             Unlike DownloadService this is deliberately not START_STICKY. There
             is no persisted queue behind it, so a system restart would begin an
             unasked-for sweep from the top - and losing one costs nothing,
             because the counts it already wrote are correct on their own. -->
        <service
            android:name=".LibraryRefreshService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
