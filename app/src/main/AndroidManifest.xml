<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to download JSON and APKs -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to prompt the user to install an APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets us enumerate installed extension packages on Android 11+.
         This is what ExtensionLoader relies on to find packages declaring
         the tachiyomi.extension feature. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Chapter downloads run in a foreground service so they survive the app
         being backgrounded or swiped away. DATA_SYNC is the type Android 14
         requires to be declared for this kind of work. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ needs this granted before the progress notification shows.
         Downloads still run if it's refused; only the notification is lost. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A foreground service keeps the process alive but not the CPU: without
         this the device can suspend mid-transfer with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".App"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Yomu"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Handle configuration changes rather than being recreated by them.

             Every piece of YomuApp's state lives in `remember`, not
             `rememberSaveable` — the active source, series, chapter list and
             loaded pages include objects that can't be put in a Bundle at all.
             So an Activity recreation isn't a blip, it's a full reset to the
             Library tab, and anything that provokes one throws away what the
             user was reading.

             The reader's rotation setting provoked one every time it opened:
             setting requestedOrientation *is* a configuration change, so the
             reader recreated the Activity, lost itself, and dropped back to the
             Library — repeatedly, with no way to reach the setting and turn it
             off. Declaring these makes the change something Compose absorbs by
             recomposing, which it does natively through LocalConfiguration.

             This also fixes the older, quieter version of the same bug: simply
             rotating the phone mid-chapter used to lose your place. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
